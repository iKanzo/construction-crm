{
  "name": "construction-crm",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w frontend",
    "build": "npm run build -w frontend",
    "typecheck": "npm run typecheck -w frontend",
    "lint": "npm run lint -w frontend",
    "test": "npm run test -w frontend",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "supabase": "supabase --workdir backend",
    "db:start": "supabase --workdir backend start",
    "db:stop": "supabase --workdir backend stop",
    "db:reset": "supabase --workdir backend db reset",
    "test:db": "supabase --workdir backend test db ../tests/backend/database",
    "test:db:local": "bash tests/backend/local/run.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "prettier": "^3.3.3",
    "supabase": "^3.0.0"
  }
}
